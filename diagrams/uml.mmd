classDiagram
    class Task {
        +str description
        +str time
        +int duration
        +int priority
        +str frequency
        +bool completed
        +mark_complete() None
        +date due_date
    }

    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task) None
    }

    class Owner {
        +str name
        +int available_minutes
        +list pets
        +add_pet(pet) None
        +get_all_tasks() list
    }

    class Scheduler {
        +Owner owner
        +sort_tasks() list
        +generate_plan() list
    }

